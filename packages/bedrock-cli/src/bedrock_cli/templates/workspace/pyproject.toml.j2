[project]
name = "{{ project_name }}"
version = "0.1.0"
description = ""
requires-python = ">=3.12"
dependencies = [
    "bedrock-core>=0.2.0",
]

[dependency-groups]
dev = [
    "ruff>=0.15.10",
]

[build-system]
requires = ["uv_build>=0.8,<0.9"]
build-backend = "uv_build"

[tool.uv.build-backend]
module-root = "src"
module-name = "{{ package_base }}"